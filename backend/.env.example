RECIPE_DATABASE_URL=sqlite:///./recipe.db
RECIPE_CORS_ORIGINS=["http://localhost:5173"]

# Session lifetime, in days, from creation (not slid on use). 0 is legal and
# means a token that is already expired the moment it's issued (used to
# exercise the expiry branch in tests).
RECIPE_SESSION_TTL_DAYS=30

# Registration is closed by default. Flip both of these on only for the
# first-user bootstrap runbook (see root README.md "Operating the server"),
# then turn them back off and restart before serving real traffic.
RECIPE_ALLOW_REGISTRATION=false
RECIPE_REGISTRATION_CODE=
