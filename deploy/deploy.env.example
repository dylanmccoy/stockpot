# Household deployment configuration (private-household-deployment ticket 04a).
#
# Copy to deploy/deploy.env and edit for the target host. deploy/deploy.env is
# git-ignored; keep host-specific paths and ports there, not in version control.
# Every value below can also be supplied through the environment instead.
#
# Determined during installation on the target Windows/WSL machine — do not
# assume the values match the development environment.

# The WSL distribution the deployment runs inside. Recorded and echoed by
# `deploy/control.sh status`; the Windows-side start-on-boot / keep-alive wiring
# that consumes it lands in tickets 06b/06c. Defaults to $WSL_DISTRO_NAME.
RECIPE_DEPLOY_WSL_DISTRO=Ubuntu

# Absolute path to this repository checkout inside WSL.
RECIPE_DEPLOY_CHECKOUT=/home/you/recipe

# Executables. Absolute paths if they are not on the service account's PATH.
RECIPE_DEPLOY_UV_BIN=uv
RECIPE_DEPLOY_NPM_BIN=npm

# Loopback port the app listens on. Bound to 127.0.0.1 only — the private HTTPS
# ingress in front of it is ticket 05a (Tailscale Serve).
RECIPE_DEPLOY_PORT=8000

# Persistent data root on WSL Linux storage, OUTSIDE the checkout and outside
# the disposable frontend build. The database, backups, pidfile and log live
# under here by default.
RECIPE_DEPLOY_DATA_DIR=/home/you/.local/share/recipe-app

# Explicit absolute database location. Every start uses exactly this file, so
# starting from another working directory can never create a second household
# database. Default: $RECIPE_DEPLOY_DATA_DIR/recipe.db
#RECIPE_DEPLOY_DB_FILE=/home/you/.local/share/recipe-app/recipe.db

# Snapshot directory used by the pre-adoption backup (and later by scheduled
# backups, ticket 07a). Default: $RECIPE_DEPLOY_DATA_DIR/backups
#RECIPE_DEPLOY_BACKUP_DIR=/home/you/.local/share/recipe-app/backups

# Pidfile + log directory. Default: $RECIPE_DEPLOY_DATA_DIR/run
#RECIPE_DEPLOY_RUNTIME_DIR=/home/you/.local/share/recipe-app/run

# Built frontend served alongside the API (one origin). Disposable — rebuilt by
# `deploy/install.sh`. Default: $RECIPE_DEPLOY_CHECKOUT/frontend/dist
#RECIPE_DEPLOY_FRONTEND_DIST=/home/you/recipe/frontend/dist

# Retained previous builds for `deploy/rollback.sh` (ticket 04c). `deploy/update.sh`
# copies the build it replaces into here as <UTC timestamp>/; rollback switches
# the deployment back to one of them. Keep it outside the checkout and the
# disposable live build. Default: $RECIPE_DEPLOY_DATA_DIR/builds
#RECIPE_DEPLOY_BUILD_ARCHIVE=/home/you/.local/share/recipe-app/builds

# How many retained builds to keep (newest wins). Default: 5
#RECIPE_DEPLOY_BUILD_KEEP=5
