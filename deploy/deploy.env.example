# Household deployment configuration (private-household-deployment ticket 04a).
#
# Copy to deploy/deploy.env and edit for the target host. deploy/deploy.env is
# git-ignored; keep host-specific paths and ports there, not in version control.
# Every value below can also be supplied through the environment instead.
#
# Determined during installation on the target Windows/WSL machine — do not
# assume the values match the development environment.

# The WSL distribution the deployment runs inside. Recorded and echoed by
# `deploy/control.sh status`; the Windows-side start-on-boot / keep-alive wiring
# that consumes it lands in tickets 06b/06c. Defaults to $WSL_DISTRO_NAME.
RECIPE_DEPLOY_WSL_DISTRO=Ubuntu

# Absolute path to this repository checkout inside WSL.
RECIPE_DEPLOY_CHECKOUT=/home/you/recipe

# Executables. Absolute paths if they are not on the service account's PATH.
RECIPE_DEPLOY_UV_BIN=uv
RECIPE_DEPLOY_NPM_BIN=npm

# Loopback port the app listens on. Bound to 127.0.0.1 only — the private HTTPS
# ingress in front of it is Tailscale Serve (ticket 05a, below).
RECIPE_DEPLOY_PORT=8000

# --- process supervision (ticket 06a) --------------------------------------
# deploy/supervise.sh runs a watch loop around deploy/control.sh that restarts
# the app process if it exits while the WSL distribution stays up. It supervises
# the app process ONLY — keeping WSL alive is ticket 06b, start-on-boot is 06c.

# Seconds between app liveness checks. Default: 3
#RECIPE_DEPLOY_SUPERVISE_INTERVAL=3

# Crash-loop damper cap, in seconds. When a restart fails, or the app comes back
# and then exits again within this many seconds, the loop waits a delay that
# doubles each time (capped here) before the next restart, and resets once the
# app holds. A one-off crash is still restarted at once; a broken build cannot
# spin. Default: 60
#RECIPE_DEPLOY_SUPERVISE_BACKOFF_MAX=60

# --- private HTTPS ingress (ticket 05a) --------------------------------------
# Windows Tailscale Serve proxies its localhost:RECIPE_DEPLOY_PORT — which WSL2
# forwards to this app — onto the tailnet over HTTPS, private to permitted
# household devices. deploy/tailscale-serve.sh applies it; deploy/net-check.sh
# verifies it. App listeners stay on 127.0.0.1; Funnel is never enabled.

# The Tailscale CLI. From inside WSL this is the Windows client, `tailscale.exe`
# (it owns the tailnet node and the localhost proxy). On the Windows side it is
# `tailscale`. An absolute path works too.
RECIPE_DEPLOY_TAILSCALE_BIN=tailscale.exe

# Tailnet port Serve listens on. 443 is the only port a browser reaches without
# an explicit ":port". Default: 443
#RECIPE_DEPLOY_HTTPS_PORT=443

# Persistent data root on WSL Linux storage, OUTSIDE the checkout and outside
# the disposable frontend build. The database, backups, pidfile and log live
# under here by default.
RECIPE_DEPLOY_DATA_DIR=/home/you/.local/share/recipe-app

# Explicit absolute database location. Every start uses exactly this file, so
# starting from another working directory can never create a second household
# database. Default: $RECIPE_DEPLOY_DATA_DIR/recipe.db
#RECIPE_DEPLOY_DB_FILE=/home/you/.local/share/recipe-app/recipe.db

# Snapshot directory used by the pre-adoption backup and by the scheduled daily
# backup (ticket 07a, deploy/backup-run.sh). Default: $RECIPE_DEPLOY_DATA_DIR/backups
#RECIPE_DEPLOY_BACKUP_DIR=/home/you/.local/share/recipe-app/backups

# Wall-clock ceiling (seconds) for one unattended backup job (ticket 07a).
# deploy/backup-run.sh runs the snapshot under `timeout` so a stuck database
# lock cannot wedge the scheduled task; on the limit it reports failure and
# leaves earlier snapshots in place. Default: 300
#RECIPE_DEPLOY_BACKUP_TIMEOUT=300

# Local backup retention (ticket 07b). After a successful snapshot,
# deploy/backup-run.sh keeps the newest N valid snapshots and drops older ones
# (`scripts/backup_status.py --prune`). Count-based on purpose: a failed run
# adds no snapshot, so it never evicts an earlier success. At one snapshot a
# day, 14 is two weeks of recovery points. Default: 14
#RECIPE_DEPLOY_BACKUP_KEEP=14

# Recovery-freshness target (hours). `scripts/backup_status.py` flags no
# successful backup on disk, or a latest success older than this, and exits
# non-zero so an unattended caller notices without a hosted alerting service.
# Matches the spec's 24-hour recovery objective. Default: 24
#RECIPE_DEPLOY_BACKUP_MAX_AGE_HOURS=24

# Pidfile + log directory. Default: $RECIPE_DEPLOY_DATA_DIR/run
#RECIPE_DEPLOY_RUNTIME_DIR=/home/you/.local/share/recipe-app/run

# Built frontend served alongside the API (one origin). Disposable — rebuilt by
# `deploy/install.sh`. Default: $RECIPE_DEPLOY_CHECKOUT/frontend/dist
#RECIPE_DEPLOY_FRONTEND_DIST=/home/you/recipe/frontend/dist

# Retained previous builds for `deploy/rollback.sh` (ticket 04c). `deploy/update.sh`
# copies the build it replaces into here as <UTC timestamp>/; rollback switches
# the deployment back to one of them. Keep it outside the checkout and the
# disposable live build. Default: $RECIPE_DEPLOY_DATA_DIR/builds
#RECIPE_DEPLOY_BUILD_ARCHIVE=/home/you/.local/share/recipe-app/builds

# How many retained builds to keep (newest wins). Default: 5
#RECIPE_DEPLOY_BUILD_KEEP=5
